# Application
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=courier_platform

# UrbaneBolt Courier (UAT)
URBANEBOLT_BASE_URL=https://uat-api.urbanebolt.com
URBANEBOLT_USERNAME=your_username
URBANEBOLT_PASSWORD=your_password
URBANEBOLT_API_KEY=your_api_key

# Resilience
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=10000

# Bulk Processing
BULK_CONCURRENCY_LIMIT=10
BULK_MAX_BATCH_SIZE=100
